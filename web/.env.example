# Optional: WalletConnect Cloud project id, enables mobile wallets via QR
NEXT_PUBLIC_WALLET_CONNECT_PROJECT_ID=

# Optional: override the Mezo testnet RPC (defaults to https://rpc.test.mezo.org)
NEXT_PUBLIC_MEZO_RPC_URL=

# Optional: public URL of the deployed app, shown to wallets
NEXT_PUBLIC_APP_URL=
