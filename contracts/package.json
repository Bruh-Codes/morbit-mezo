{
  "name": "morbit-contracts",
  "type": "module",
  "packageManager": "yarn@4.9.2",
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat compile && node --import tsx/esm --test \"test/*.ts\"",
    "deploy:mezo": "hardhat run scripts/deploy-mezo.js --network mezoTestnet",
    "smoke:mezo": "hardhat run scripts/smoke-mezo.js --network mezoTestnet",
    "deploy:auto-earn": "hardhat run scripts/deploy-auto-earn.js --network mezoTestnet",
    "smoke:auto-earn": "hardhat run scripts/smoke-auto-earn.js --network mezoTestnet",
    "deploy:wave2": "hardhat run scripts/deploy-auto-earn.js --network mezoTestnet",
    "finish:wave2": "hardhat run scripts/finish-wave2.js --network mezoTestnet",
    "liquidate": "hardhat run scripts/liquidate.js --network mezoTestnet",
    "deploy:earn-v3": "hardhat run scripts/deploy-earn-v3.js --network mezoTestnet",
    "verify:mezo": "hardhat run scripts/verify-mezo.js --network mezoTestnet"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-ethers": "^4.0.13",
    "@nomicfoundation/hardhat-ignition": "^3.1.7",
    "@nomicfoundation/hardhat-ignition-ethers": "^3.1.6",
    "@nomicfoundation/hardhat-keystore": "^3.0.12",
    "@nomicfoundation/hardhat-verify": "^3.0.20",
    "@openzeppelin/contracts": "^5.6.1",
    "@openzeppelin/contracts-upgradeable": "^5.6.1",
    "ethers": "^6.16.0",
    "hardhat": "^3.9.0",
    "tsx": "^4.23.15"
  }
}
